# Performance Profile: 8 GB Unified Memory / Constrained RAM & VRAM
# Usage: Copy contents to .env or source before running docker compose

OLLAMA_RESIDENCY_ENABLED=false
OLLAMA_KEEP_ALIVE=3m
OLLAMA_GENERATION_NUM_CTX=4096
OLLAMA_GENERATION_NUM_PREDICT=1536
OLLAMA_OPTIMIZED_NUM_CTX=8192
OLLAMA_OPTIMIZED_NUM_PREDICT=2048

CV_PROCESSING_CONCURRENCY=1
DOCUMENT_PARSER_WORKERS=1

DOCUMENT_TABLE_STRUCTURE_ENABLED=false
PREFER_NATIVE_TEXT_EXTRACTION=true

DOCLING_NUM_THREADS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
MALLOC_ARENA_MAX=2
