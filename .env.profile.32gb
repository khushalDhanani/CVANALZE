# Performance Profile: 32+ GB Unified Memory / Dedicated VRAM / High Performance Workstation
# Usage: Copy contents to .env or source before running docker compose

OLLAMA_RESIDENCY_ENABLED=true
OLLAMA_KEEP_ALIVE=-1
OLLAMA_GENERATION_NUM_CTX=16384
OLLAMA_GENERATION_NUM_PREDICT=3072
OLLAMA_OPTIMIZED_NUM_CTX=32768
OLLAMA_OPTIMIZED_NUM_PREDICT=4096

CV_PROCESSING_CONCURRENCY=1
DOCUMENT_PARSER_WORKERS=4

DOCUMENT_TABLE_STRUCTURE_ENABLED=true
PREFER_NATIVE_TEXT_EXTRACTION=false

DOCLING_NUM_THREADS=4
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
MKL_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4
MALLOC_ARENA_MAX=4
