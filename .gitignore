# =========================
# Standard .gitignore
# =========================

# Operating System
.DS_Store
Thumbs.db

# =========================
# Backend (Python)
# =========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Cache files
.cache/
*.cache
.llm_cache/
.pytest_cache/
.mypy_cache/

# Application Specific
backend/uploads/
backend/scripts/db_analysis_output.json
backend/final_output.json
backend/llm_cache.db

# =========================
# Frontend (Node / React / Expo)
# =========================
# node_modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
.expo/
web-build/
.next/
out/
dist-ssr/

# Environment variables
.env.local
.env.*.local

# Coverage directories
coverage/
.nyc_output/

# =========================
# IDEs and Editors
# =========================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
