# Local development template. Do not commit real credentials.
MSSQL_READ_ONLY_URL=mssql+pyodbc://<user>:<password>@localhost:1433/<db_name>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
POSTGRES_APP_URL=postgresql://<user>:<password>@localhost:5432/cv_analyzer
REDIS_URL=redis://localhost:6379/0
APP_ENVIRONMENT=development
AUTH_ENABLED=false
# JSON arrays. Generate unique secrets; never use these placeholders in a deployment.
RECRUITER_API_KEYS=[]
ADMINISTRATOR_API_KEYS=[]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_BUCKETS=10000
MAX_JSON_REQUEST_SIZE_BYTES=1048576
MAX_CV_TEXT_LENGTH_CHARS=500000
MAX_HR_FEEDBACK_LENGTH_CHARS=10000
INITIALIZE_DATABASE_ON_STARTUP=true
STARTUP_CACHE_WARMUP_ENABLED=true
DOCUMENT_PARSER_WORKERS=1
DOCUMENT_TABLE_STRUCTURE_ENABLED=true
PREFER_NATIVE_TEXT_EXTRACTION=false
RQ_QUEUE_NAME=cv-processing
RQ_JOB_TIMEOUT_SECONDS=900
RQ_RESULT_TTL_SECONDS=604800
RQ_MAX_RETRIES=2
RQ_RETRY_INTERVAL_SECONDS=30
RQ_DEVELOPMENT_FALLBACK_ENABLED=true
PROCESSING_JOB_TTL_SECONDS=604800
PROCESSING_JOB_LOCK_TIMEOUT_SECONDS=1200
# Optional ISO-8601 deadline for the legacy unknown-job polling response.
# JOB_NOT_FOUND_COMPATIBILITY_UNTIL=2026-09-01T00:00:00Z

LLM_ENABLED=true
EMBEDDING_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_REQUEST_TIMEOUT=60
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_TAGS_TIMEOUT_SECONDS=3
OLLAMA_GENERATE_TIMEOUT_SECONDS=60
OLLAMA_EMBED_TIMEOUT_SECONDS=30
OLLAMA_UNLOAD_TIMEOUT_SECONDS=10
OLLAMA_MAX_RETRIES=0
OLLAMA_RETRY_BACKOFF_SECONDS=0.5
OLLAMA_KEEP_ALIVE=1m
OLLAMA_UNLOAD_ON_SHUTDOWN=true
OLLAMA_MAX_CONNECTIONS=1
OLLAMA_MAX_KEEPALIVE_CONNECTIONS=1
OLLAMA_MAX_RESPONSE_BYTES=4194304
OLLAMA_LOCK_FILE=uploads/.locks/ollama.lock
OLLAMA_LOCK_TIMEOUT_SECONDS=65
OLLAMA_EMBED_BATCH_SIZE=10
OLLAMA_EMBED_MIN_SPLIT_SIZE=2
OLLAMA_EMBEDDING_EXPECTED_DIMENSION=768
OLLAMA_EMBEDDING_MAX_DIMENSION=4096
OLLAMA_LIVE_TESTS_ENABLED=false
OLLAMA_GENERATION_NUM_CTX=4096
OLLAMA_GENERATION_NUM_PREDICT=1024
OLLAMA_OPTIMIZED_NUM_PREDICT=2048
EMBEDDING_MODEL=nomic-embed-text

ALLOWED_ORIGINS=["http://localhost:8081"]
CORS_ALLOW_CREDENTIALS=false
AUTO_MIGRATE=false

# Secure upload policy. Only PDF and DOCX are supported.
ALLOWED_EXTENSIONS=["pdf","docx"]
MAX_FILE_SIZE_BYTES=15728640
UPLOAD_READ_CHUNK_SIZE_BYTES=1048576
UPLOAD_FILENAME_MAX_CHARS=120
MAX_DOCX_EXPANDED_SIZE_BYTES=78643200
MAX_DOCX_ENTRIES=2000
MAX_DOCX_COMPRESSION_RATIO=200
MAX_PDF_PAGES=100
MAX_PDF_XREF_OBJECTS=10000
MAX_PDF_IMAGES=1000
MAX_PDF_TOTAL_PAGE_AREA_POINTS=500000000
MAX_PDF_EMBEDDED_FILES=0
RAW_UPLOAD_RETENTION_DAYS=30
RAW_UPLOAD_DELETE_ON_SUCCESS=false
RAW_UPLOAD_DELETE_ON_FAILURE=false
