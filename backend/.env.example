# Local development template. Do not commit real credentials.
MSSQL_READ_ONLY_URL=mssql+pyodbc://<user>:<password>@localhost:1433/<db_name>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
MSSQL_READONLY_ENFORCEMENT=true
POSTGRES_APP_URL=postgresql://<user>:<password>@localhost:5432/cv_analyzer
REDIS_URL=redis://localhost:6379/0
SHADOW_MODE_ENABLED=false
APP_ENVIRONMENT=development
APP_VERSION=3.0.0
GIT_SHA=unknown
AUTH_ENABLED=false
# JSON arrays. Generate unique secrets; never use these placeholders in a deployment.
RECRUITER_API_KEYS=[]
ADMINISTRATOR_API_KEYS=[]
# Independent random secret with at least 32 characters. Do not reuse an API key.
AUTH_SESSION_SIGNING_KEY=
AUTH_SESSION_TTL_SECONDS=28800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_BUCKETS=10000
MAX_JSON_REQUEST_SIZE_BYTES=1048576
MAX_CV_TEXT_LENGTH_CHARS=500000
MAX_HR_FEEDBACK_LENGTH_CHARS=10000
INITIALIZE_DATABASE_ON_STARTUP=true
STARTUP_CACHE_WARMUP_ENABLED=true
DOCUMENT_PARSER_WORKERS=1
EXTRACTION_TIMEOUT_SECONDS=300
SCANNED_EXTRACTION_TIMEOUT_SECONDS=600
DOCUMENT_TABLE_STRUCTURE_ENABLED=true
PREFER_NATIVE_TEXT_EXTRACTION=false
RQ_QUEUE_NAME=cv-processing
# Optional worker recycle limit. Zero keeps the production worker running.
RQ_WORKER_MAX_JOBS=0
RQ_JOB_TIMEOUT_SECONDS=900
RQ_RESULT_TTL_SECONDS=604800
BACKGROUND_SYNC_ENABLED=true
BACKGROUND_SYNC_INTERVAL_SECONDS=900
BACKGROUND_SYNC_JOB_TIMEOUT_SECONDS=1800
BACKGROUND_SYNC_LOCK_TIMEOUT_SECONDS=3600
VALIDATION_METRICS_SNAPSHOT_ENABLED=true
VALIDATION_METRICS_SNAPSHOT_INTERVAL_SECONDS=86400
RQ_MAX_RETRIES=2
RQ_RETRY_INTERVAL_SECONDS=30
SHADOW_VALIDATION_MAX_RETRIES=3
SHADOW_VALIDATION_RETRY_INTERVAL_SECONDS=60
SHADOW_VALIDATION_JOB_TIMEOUT_SECONDS=600
RULE_CONFIG_RETRY_INTERVAL_SECONDS=5
CV_JOB_RECONCILIATION_INTERVAL_SECONDS=60
CV_JOB_STALE_AFTER_SECONDS=1200
CV_JOB_HISTORY_HOURS=24
CV_JOB_LIST_LIMIT=100
RQ_DEVELOPMENT_FALLBACK_ENABLED=true
PROCESSING_JOB_TTL_SECONDS=604800
PROCESSING_JOB_LOCK_TIMEOUT_SECONDS=1200
PROCESSING_RECOVERY_LOCK_TIMEOUT_SECONDS=30
PROCESSING_RECOVERY_LOCK_BLOCKING_TIMEOUT_SECONDS=0
REDIS_LOCK_BLOCKING_TIMEOUT_SECONDS=10
REDIS_AVAILABILITY_PROBE_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=30
REDIS_CONNECT_TIMEOUT_SECONDS=10
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_SCAN_COUNT=1000
REDIS_LOCK_TIMEOUT_SECONDS=120
CACHE_FILE_LOCK_TIMEOUT_SECONDS=5
SCHEDULER_REDIS_RETRY_DELAY_SECONDS=5
CONFIG_INVALIDATION_RETRY_SECONDS=5
API_STREAM_POLL_TIMEOUT_SECONDS=1
API_STREAM_IDLE_SLEEP_SECONDS=0.1
JOB_CACHE_STALENESS_TTL_SECONDS=30
INTEGRATION_SYNC_BATCH_SIZE=1000
SOURCE_FRESHNESS_MAX_AGE_SECONDS=3600
# Optional ISO-8601 deadline for the legacy unknown-job polling response.
# JOB_NOT_FOUND_COMPATIBILITY_UNTIL=2026-09-01T00:00:00Z

# Performance Profile Templates:
# See repository root templates for hardware presets (.env.profile.8gb, .env.profile.16gb, .env.profile.32gb)

LLM_ENABLED=true
EMBEDDING_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_TAGS_TIMEOUT_SECONDS=3
OLLAMA_GENERATE_TIMEOUT_SECONDS=360
OLLAMA_EMBED_TIMEOUT_SECONDS=30
OLLAMA_UNLOAD_TIMEOUT_SECONDS=10
OLLAMA_MAX_RETRIES=0
OLLAMA_RETRY_BACKOFF_SECONDS=0.5
OLLAMA_KEEP_ALIVE=30m
OLLAMA_UNLOAD_ON_SHUTDOWN=true
OLLAMA_MAX_CONNECTIONS=1
OLLAMA_MAX_KEEPALIVE_CONNECTIONS=1
OLLAMA_MAX_RESPONSE_BYTES=4194304
# OLLAMA_LOCK_FILE is derived from APP_DATA_ROOT when omitted.
OLLAMA_LOCK_TIMEOUT_SECONDS=65
OLLAMA_EMBED_BATCH_SIZE=10
OLLAMA_EMBED_MIN_SPLIT_SIZE=2
OLLAMA_EMBEDDING_EXPECTED_DIMENSION=768
OLLAMA_EMBEDDING_MAX_DIMENSION=4096
OLLAMA_LIVE_TESTS_ENABLED=false
OLLAMA_GENERATION_NUM_CTX=8192
OLLAMA_GENERATION_NUM_PREDICT=1536
OLLAMA_THINKING_MODEL_FAMILIES=["deepseek-r1","gpt-oss","qwen3","qwen3.5"]
OLLAMA_GENERATION_TEMPERATURE=0
OLLAMA_OPTIMIZED_NUM_CTX=16384
OLLAMA_OPTIMIZED_NUM_PREDICT=3072
OLLAMA_OPTIMIZED_TOP_P=0.9
EMBEDDING_MODEL=nomic-embed-text

ALLOWED_ORIGINS=["http://localhost:8081"]
CORS_ALLOW_CREDENTIALS=true
AUTO_MIGRATE=false

# Secure upload policy. Only PDF and DOCX are supported.
ALLOWED_EXTENSIONS=["pdf","docx"]
ALLOWED_MIME_TYPES={"pdf":["application/pdf","application/x-pdf","application/octet-stream"],"docx":["application/vnd.openxmlformats-officedocument.wordprocessingml.document","application/zip","application/x-zip-compressed","application/octet-stream"]}
MAX_FILE_SIZE_BYTES=15728640
MAX_UPLOAD_FILES_PER_SELECTION=10
UPLOAD_READ_CHUNK_SIZE_BYTES=1048576
UPLOAD_FILENAME_MAX_CHARS=120
MAX_DOCX_EXPANDED_SIZE_BYTES=78643200
MAX_DOCX_ENTRIES=2000
MAX_DOCX_COMPRESSION_RATIO=200
MAX_PDF_PAGES=100
MAX_PDF_XREF_OBJECTS=10000
MAX_PDF_IMAGES=1000
MAX_PDF_TOTAL_PAGE_AREA_POINTS=500000000
MAX_PDF_EMBEDDED_FILES=0
RAW_UPLOAD_RETENTION_DAYS=30
RAW_UPLOAD_DELETE_ON_SUCCESS=false
RAW_UPLOAD_DELETE_ON_FAILURE=false

# Canonical data root. UPLOADS_DIR, RESULTS_DIR, LOCK_DIR, and TRAINING_DATA_DIR
# are derived from this value when their explicit overrides are omitted.
APP_DATA_ROOT=uploads

# Public capabilities consumed by the recruiter frontend.
BATCH_CANDIDATE_LIMIT_OPTIONS=[5,10,20,30]
DEFAULT_BATCH_CANDIDATE_LIMIT=10
MAX_BATCH_LIMIT=50
RECOMMENDED_POLL_INTERVAL_MS=3000
RECOMMENDED_MAX_POLL_ATTEMPTS=1200
DOCUMENT_PARSER_DISPLAY_NAME=Docling
OCR_ENGINE_DISPLAY_NAME=RapidOCR
LLM_PROVIDER_DISPLAY_NAME=Ollama local LLM
VECTOR_STORE_DISPLAY_NAME=PostgreSQL pgvector
