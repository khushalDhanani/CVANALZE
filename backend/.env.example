# Local development template. Do not commit real credentials.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_CERT=false

PG_DB_URL=postgresql://<user>:<password>@localhost:5432/cv_analyzer
REDIS_URL=redis://localhost:6379/0

LLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_REQUEST_TIMEOUT=90
OLLAMA_MAX_RETRIES=1
EMBEDDING_MODEL=nomic-embed-text

ALLOWED_ORIGINS=["http://localhost:8081"]
AUTO_MIGRATE=false
