# Performance Profile: 16 GB Unified Memory / Medium VRAM (Default Workstation)
# Usage: Copy contents to .env or source before running docker compose

OLLAMA_RESIDENCY_ENABLED=true
OLLAMA_KEEP_ALIVE=30m
OLLAMA_GENERATION_NUM_CTX=8192
OLLAMA_GENERATION_NUM_PREDICT=1536
OLLAMA_OPTIMIZED_NUM_CTX=16384
OLLAMA_OPTIMIZED_NUM_PREDICT=3072

CV_PROCESSING_CONCURRENCY=1
DOCUMENT_PARSER_WORKERS=2

DOCUMENT_TABLE_STRUCTURE_ENABLED=true
PREFER_NATIVE_TEXT_EXTRACTION=false

DOCLING_NUM_THREADS=2
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
MALLOC_ARENA_MAX=2
