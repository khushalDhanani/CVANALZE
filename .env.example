# Docker Compose interpolation template. Copy to the ignored repository-root .env.
APP_ENVIRONMENT=development
APP_VERSION=3.0.0
GIT_SHA=unknown

# Local Compose provisions PostgreSQL/Redis from these disposable development values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cv_analyzer

# External deployments must provide secure application URLs; the base Compose file
# intentionally supplies no database or Redis credential defaults.
POSTGRES_APP_URL=
REDIS_URL=
MSSQL_READ_ONLY_URL=
MSSQL_READONLY_ENFORCEMENT=true

AUTH_ENABLED=false
RECRUITER_API_KEYS=[]
ADMINISTRATOR_API_KEYS=[]
AUTH_SESSION_SIGNING_KEY=
ALLOWED_ORIGINS=["http://localhost:8081"]

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_GENERATE_TIMEOUT_SECONDS=360
